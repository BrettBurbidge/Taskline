// This is your Prisma schema file
// Taskline - Personal AI Project Assistant

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// USER (Managed by Supabase Auth)
// ============================================================================
model User {
  id        String   @id // Supabase auth.users.id
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  people   Person[]
  projects Project[]
  tasks    Task[]
  apiKeys  ApiKey[]

  @@map("user")
}

// ============================================================================
// API KEY (Per-user keys for external API access)
// ============================================================================
model ApiKey {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  key        String    @unique
  name       String    @default("Default")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_key")
}

// ============================================================================
// PERSON
// ============================================================================
model Person {
  id          String   @id @default(uuid())
  userId      String   @map("user_id") // Multi-tenant isolation
  handle      String // e.g., "brett", "steen"
  displayName String   @map("display_name")
  email       String?
  source      String   @default("manual") // "manual", "import"
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountableTasks   Task[]        @relation("AccountablePerson")
  executorTasks      Task[]        @relation("ExecutorPerson")
  stakeholderOn      Stakeholder[]
  followUpsTargeting FollowUp[]    @relation("FollowUpTargetPerson")

  @@unique([userId, handle]) // Handle must be unique per user
  @@index([userId])
  @@map("person")
}

// ============================================================================
// PROJECT
// ============================================================================
model Project {
  id          String    @id @default(uuid())
  userId      String    @map("user_id") // Multi-tenant isolation
  name        String
  description String?
  dueAt       DateTime? @map("due_at") // informational only in v1
  isActive    Boolean   @default(true) @map("is_active")
  isPersonal  Boolean   @default(false) @map("is_personal") // excluded from work summaries/reports
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks        Task[]
  contextNotes ContextNote[]

  @@index([userId])
  @@map("project")
}

// ============================================================================
// TASK
// ============================================================================
model Task {
  id          String    @id @default(uuid())
  userId      String    @map("user_id") // Multi-tenant isolation
  title       String
  description String?
  status      String    @default("not_started") // not_started, in_progress, waiting, completed, cancelled
  priority    String? // low, medium, high — AI-suggested at capture time
  dueAt       DateTime? @map("due_at")
  boardDate   DateTime? @map("board_date") @db.Date
  sortOrder   Int?      @map("sort_order")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // --- Analytics capture (all populated automatically, never by hand) ---
  // The first due date ever set, never overwritten — lets lateness be measured
  // against the original commitment rather than the latest reschedule.
  // NULL on rows that predate this column: "history unknown", which is
  // deliberately distinct from dueAtChangeCount = 0 ("never moved").
  originalDueAt    DateTime? @map("original_due_at")
  dueAtChangeCount Int       @default(0) @map("due_at_change_count")
  // First day the task appeared on the daily board, and how many distinct days
  // it has occupied it — an aging / real-effort proxy.
  firstBoardDate   DateTime? @map("first_board_date") @db.Date
  boardDayCount    Int       @default(1) @map("board_day_count")
  // AI-classified at capture time; null whenever AI is unavailable.
  taskType         String?   @map("task_type") // admin, deep_work, followup, meeting, errand, other
  estimatedMinutes Int?      @map("estimated_minutes")

  // Foreign Keys
  projectId           String? @map("project_id")
  accountablePersonId String  @map("accountable_person_id")
  executorPersonId    String? @map("executor_person_id")

  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project           Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  accountablePerson Person   @relation("AccountablePerson", fields: [accountablePersonId], references: [id])
  executorPerson    Person?  @relation("ExecutorPerson", fields: [executorPersonId], references: [id])

  stakeholders  Stakeholder[]
  followUpRules FollowUpRule[]
  followUps     FollowUp[]
  contextNotes  ContextNote[]
  activities    TaskActivity[]

  @@index([userId])
  @@index([boardDate, sortOrder])
  @@index([dueAt])
  @@index([status])
  @@map("task")
}

// ============================================================================
// STAKEHOLDER
// ============================================================================
model Stakeholder {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  personId  String   @map("person_id")
  role      String? // optional description
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([taskId, personId])
  @@map("stakeholder")
}

// ============================================================================
// FOLLOW-UP RULE
// ============================================================================
model FollowUpRule {
  id         String   @id @default(uuid())
  taskId     String   @map("task_id")
  ruleType   String   @map("rule_type") // self_accountability, executor_checkin, stakeholder_update
  isActive   Boolean  @default(true) @map("is_active")
  configJson Json     @map("config_json") // stores cadence config, etc.
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("followup_rule")
}

// ============================================================================
// FOLLOW-UP
// ============================================================================
model FollowUp {
  id             String    @id @default(uuid())
  taskId         String    @map("task_id")
  followUpType   String    @map("followup_type") // self_accountability, executor_checkin, stakeholder_update
  targetPersonId String?   @map("target_person_id")
  dueAt          DateTime  @map("due_at")
  status         String    @default("pending") // pending, completed, snoozed
  completedAt    DateTime? @map("completed_at")
  snoozedUntil   DateTime? @map("snoozed_until")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  task         Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  targetPerson Person? @relation("FollowUpTargetPerson", fields: [targetPersonId], references: [id], onDelete: SetNull)

  @@index([dueAt, status])
  @@index([taskId])
  @@map("followup")
}

// ============================================================================
// CONTEXT NOTE
// ============================================================================
model ContextNote {
  id        String   @id @default(uuid())
  content   String
  noteType  String   @default("general") @map("note_type") // general, meeting, link, ai_generated
  taskId    String?  @map("task_id")
  projectId String?  @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("context_note")
}

// ============================================================================
// TASK ACTIVITY (For timeline/story building)
// ============================================================================
model TaskActivity {
  id           String   @id @default(uuid())
  taskId       String   @map("task_id")
  activityType String   @map("activity_type") // created, status_changed, due_date_changed, completed, followup_completed, note_added
  description  String // Human-readable description
  metadata     Json? // Store additional data (before/after values, etc.)
  note         String? // Optional user note
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_activity")
}
