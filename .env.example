# Database connection (REQUIRED)
DATABASE_URL="postgresql://papa:papa_dev_password@localhost:5432/papa_db?schema=public"

# Direct (non-pooled) database connection (REQUIRED when DATABASE_URL is pooled)
# Prisma migrations cannot run through Supabase's pgbouncer pooler (port 6543).
# Point this at the same database on port 5432. Leave unset if DATABASE_URL is
# already a direct connection (e.g. local Postgres / Docker).
# DIRECT_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# OpenAI API Key (OPTIONAL - for AI features)
# Get your key at: https://platform.openai.com/api-keys
# Without this, AI features will be gracefully disabled
OPENAI_API_KEY="sk-proj..."

# API keys are now per-user and managed in the app at /settings
# No API key config needed in .env — generate keys from the Settings page
